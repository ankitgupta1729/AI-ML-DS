{
     "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
     "code-runner.executorMap": {
          "python": "/opt/homebrew/bin/python3 -u"
     },
     "code-runner.runInTerminal": true,
     "code-runner.fileDirectoryAsCwd": true,
     "python.terminal.activateEnvironment": false,
     "python.terminal.activateEnvInCurrentTerminal": false,
     "codescene.enableAutoRefactor": false,
     "codescene.enableReviewCodeLenses": false,
     // Per-project .venv folders in SUBFOLDERS of this repo are not discoverable
     // by the Python extension (it only scans workspace-folder roots, and
     // python.venvPath expects a folder whose immediate children are venvs).
     // Register them as global Jupyter kernelspecs instead: run `uvkernel`
     // inside the project folder once, then pick it from
     // "Select Another Kernel... -> Jupyter Kernel...".

     // --- Keep the editor's indexer off generated trees. ---
     // This workspace has ~160k files but only ~14k are source. Watching and
     // indexing the rest is what makes autocomplete die after a few minutes.
     // Note: files.exclude is deliberately NOT set, so nothing disappears
     // from the Explorer - these only affect watching, search and indexing.
     "files.watcherExclude": {
          "**/.venv/**": true,
          "**/venv/**": true,
          "**/node_modules/**": true,
          "**/.git/logs/**": true,
          "**/.git/worktrees/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/__pycache__/**": true,
          "**/.next/**": true,
          "**/.ipynb_checkpoints/**": true,
          "**/site-packages/**": true,
          "**/mlruns/**": true,
          "**/artifacts/**": true,
          "**/logs/**": true,
          "**/data/**": true,
          "**/output/**": true,
          "**/outputs/**": true,
          "**/build/**": true,
          "**/dist/**": true,
          "**/.cache/**": true
     },
     "search.exclude": {
          "**/.venv": true,
          "**/venv": true,
          "**/node_modules": true,
          "**/.git/logs": true,
          "**/.git/worktrees": true,
          "**/__pycache__": true,
          "**/.next": true,
          "**/.ipynb_checkpoints": true,
          "**/mlruns": true,
          "**/artifacts": true,
          "**/logs": true,
          "**/data": true,
          "**/output": true,
          "**/outputs": true,
          "**/build": true,
          "**/dist": true,
          "**/.cache": true
     },
     "search.followSymlinks": false,

     // --- AI ghost text vs the IntelliSense drop-down ---
     // VS Code hides inline (AI) suggestions while the suggest widget is open.
     // Typing an identifier like "impo" opens the drop-down, which silently
     // swallowed the Windsurf ghost text even though it was generated fine.
     // suppressSuggestions: true = when AI ghost text is available, hide the
     // drop-down instead of the other way round.
     "editor.inlineSuggest.enabled": true,
     "editor.inlineSuggest.suppressSuggestions": true,
     "editor.suggest.preview": true,
     // Keep the inline suggestion toolbar visible so you can tell which
     // provider answered. We still keep the UI consistent even with one
     // active provider.
     "editor.inlineSuggest.showToolbar": "always",
     "editor.inlineSuggest.triggerCommandOnProviderChange": true,
     // Keep ghost text visible when focus shifts (helps in notebook cells).
     "editor.inlineSuggest.keepOnBlur": true,
     // Small delay lets the faster providers answer before rendering.
     "editor.inlineSuggest.minShowDelay": 0,
     // Same behaviour in every cell type and file type. VS Code applies
     // editor.inlineSuggest.enabled globally, but a few languages ship
     // their own defaults, so these overrides make it explicit everywhere.
     "[python]": {
          "editor.inlineSuggest.enabled": true,
          "editor.inlineSuggest.suppressSuggestions": true
     },
     "[markdown]": {
          "editor.inlineSuggest.enabled": true,
          "editor.inlineSuggest.suppressSuggestions": true,
          "editor.quickSuggestions": {
               "other": "on",
               "comments": "on",
               "strings": "on"
          },
          "editor.wordBasedSuggestions": "allDocuments",
          "editor.suggest.showWords": true
     },
     "[plaintext]": {
          "editor.inlineSuggest.enabled": true
     },
     "[json]": {
          "editor.inlineSuggest.enabled": true
     },
     "[jsonc]": {
          "editor.inlineSuggest.enabled": true
     },
     "[yaml]": {
          "editor.inlineSuggest.enabled": true
     },
     "[shellscript]": {
          "editor.inlineSuggest.enabled": true
     },

     // ================================================================
     // ONE AI autocomplete provider: Supermaven.
     //
     // 2026-09-21: settled on Supermaven as the sole inline-completion
     // provider (purpose-built for autocomplete, generous free tier after
     // its 14-day Pro trial auto-downgrades). Every competing provider's
     // model/data was removed:
     //   - Windsurf/Codeium: extension uninstalled, ~/.codeium deleted
     //     (was dead anyway — Cognition folded it into Devin, no login).
     //   - Continue + Ollama: qwen2.5-coder:3b removed from Ollama,
     //     ~/.continue/config.yaml emptied. Extension left installed in
     //     case a local fallback is needed later.
     //   - Kilo Code's Codestral autocomplete: never actually set up
     //     (needed paid Mistral credits) — config removed as unused.
     //   - GitHub Copilot: left OFF; its free-plan completions quota is
     //     exhausted until 2026-10-01 anyway. Chat still works elsewhere.
     // ================================================================

     "supermaven.enable": true,

     "continue.enableTabAutocomplete": false,
     "continue.enableNextEdit": false,
     "continue.showInlineTip": false,

     "github.copilot.enable": {
          "*": false,
          "plaintext": false,
          "markdown": false,
          "scminput": false
     },
     "github.copilot.nextEditSuggestions.enabled": false,

     "git.ignoreLimitWarning": true
}
